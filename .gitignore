reports/figures/*
reports/experiments/*
!reports/figures/.gitkeep
!reports/experiments/.gitkeep

# Environment variables and secrets
.env
.env.*

# IDE settings
.vscode/
.idea/

# Operating system
.DS_Store
Thumbs.db

# Testing and coverage
.pytest_cache/
.coverage
htmlcov/

# Python packaging
dist/
build/
*.egg-info/
